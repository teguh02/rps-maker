{
  "name": "rps-maker",
  "version": "1.0.0",
  "description": "Word processor khusus RPS — Rencana Pembelajaran Semester UNISINA",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.unisina.rps-maker",
    "productName": "RPS Maker UNISINA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": "dmg"
    }
  },
  "keywords": [],
  "author": "teguh",
  "license": "MIT",
  "dependencies": {
    "@tiptap/extension-highlight": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-table-cell": "^3.31.0",
    "@tiptap/extension-table-header": "^3.31.0",
    "@tiptap/extension-table-row": "^3.31.0",
    "@tiptap/extension-text-align": "^3.31.0",
    "@tiptap/extension-underline": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "docx": "^9.7.1",
    "html2pdf.js": "^0.14.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}

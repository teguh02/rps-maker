{
  "name": "rps-maker",
  "version": "1.0.0",
  "description": "Word processor khusus RPS — Rencana Pembelajaran Semester UNISINA",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.unisina.rps-maker",
    "productName": "RPS Maker UNISINA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "mac": {
      "target": "dmg"
    }
  },
  "keywords": [],
  "author": "teguh",
  "license": "MIT"
}
